# Copy to .env for local development. Do not commit a filled-in copy.
#
# Only ONE value is actually required: the Lakebase URL. There is no weather
# API key because api.weather.gov does not use one.

LAKEBASE_URL=postgresql://<role>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# NWS asks that clients identify themselves and include contact info.
NWS_USER_AGENT=(databricks-lakebase-weather-rag, your-email@example.com)

# Corpus scope
NWS_PRODUCT_TYPES=AFD,HWO,ESF
NWS_OFFICES=OKX,LWX,MPX,FWD,SEW,MFL,BOU,OUN,SLC,TAE

# Vectorization. EMBEDDING_MODEL must match the VECTOR(n) width in the DDL.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150

WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings
HF_HOME=/tmp/.cache/huggingface
